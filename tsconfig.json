{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "supabase",
    "scripts",
    "tools"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
