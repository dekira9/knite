{
  "name": "knit-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --ci",
    "test:watch": "jest --watchAll",
    "test:raglan": "tsx scripts/compareRaglanCalc.mts && jest --watchAll=false utils/raglan/__tests__/calculateRaglan.test.ts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "ba": "eas build --platform android --local",
    "bi": "eas build --platform ios --local",
    "si": "eas submit -p ios",
    "lint:prune": "eslint . --prune-suppressions",
    "typecheck": "node tools/scripts/tsc-ratchet.mjs",
    "typecheck:update": "node tools/scripts/tsc-ratchet.mjs --update",
    "verify": "yarn -s typecheck && yarn -s lint && jest --ci --silent --reporters=summary",
    "i18n": "node tools/scripts/i18n.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.102.1",
    "expo": "^56.0.8",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.13",
    "expo-localization": "~56.0.6",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "i18n-js": "^4.5.0",
    "mobx": "^6.13.5",
    "mobx-react": "^9.1.1",
    "mobx-state-tree": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-paper": "^5.13.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.85.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "javascript-obfuscator": "^4.2.0",
    "jest": "^29.2.1",
    "jest-expo": "~56.0.4",
    "prettier": "^3.5.3",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.19.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
