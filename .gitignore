# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Native build caches (must not ship to EAS — absolute local paths break Linux builds)
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
ios/build/
ios/Pods/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# Local temp / merge notes (not for repo)
tmp_*.txt
